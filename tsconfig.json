{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "box",
    "test"
  ]
}
