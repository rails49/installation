# The door's own file, read by nothing else. Copy this to
# `/etc/rails49/acme.env`, edit it, and keep it out of every clone:
#
#     sudo install -m 640 -o root -g docker acme.env /etc/rails49/acme.env
#
# It lands whole in the door's environment, so what belongs in it is whatever
# the provider named by `BOX_ACME_PROVIDER` reads, plus the ACME account
# address. Traefik takes every static setting from `TRAEFIK_*`, which is what
# keeps the address out of `compose.yaml`.
#
# The installation has no opinion about how this file is populated. A machine
# with 1Password can write it from a reference file; a headless box keeps a
# root-owned file, which is the documented exception it already is.

# The ACME account address. Let's Encrypt writes to it when a certificate is
# about to expire and nobody renewed it.
TRAEFIK_CERTIFICATESRESOLVERS_LE_ACME_EMAIL=you@example.org

# Cloudflare's credential, named as Traefik's Cloudflare provider reads it. A
# token with `DNS:Edit` on the zone and nothing else. Another provider reads
# another variable: its own documentation says which.
CF_DNS_API_TOKEN=
