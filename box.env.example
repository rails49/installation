# What a box is, in one file. Copy this to `/etc/rails49/box.env` and edit it.
#
# Every stack on the box is started against this file — the installation,
# `control`, `dccex` — so the box's name is written once and two stacks cannot
# come to different answers about it. The path is fixed rather than living in
# any clone, because a value inside one clone makes that clone a prerequisite
# of every other stack.
#
# No secret belongs here. The ACME credential is in `acme.env` beside it, read
# by the door alone, so that handing this file to another stack does not hand
# it the box's DNS credentials — and so that this one can be pasted into an
# issue while debugging a headless box.

# The name the box is reached at. The installation page lives here, and every
# UI the box serves is a label under it.
BOX_DOMAIN=gleis49.org

# The UIs this box serves, space-separated and lowercase, in the order the page
# should list them. Each one is a label: `control` is reached at
# `https://control.$BOX_DOMAIN`. The apex is never among them — the page lives
# there by definition. A box that serves nothing yet leaves this empty.
BOX_UIS="control jmri"

# Which DNS provider issues the box's certificates, spelled as Traefik spells
# it. Cloudflare is the worked example and not the scheme: the stock Traefik
# binary carries every provider, and `acme.env` holds whatever credential the
# one named here reads.
BOX_ACME_PROVIDER=cloudflare
